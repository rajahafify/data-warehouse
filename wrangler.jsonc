{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "data-warehouse",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // McpAgent keeps each MCP session in a Durable Object.
  "durable_objects": {
    "bindings": [{ "name": "MCP_OBJECT", "class_name": "ProjectMemoryMCP" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectMemoryMCP"] }],

  // Projects + notes. Replace database_id after `npx wrangler d1 create project-memory`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "project-memory",
      "database_id": "4cb5145b-0c96-4e0f-8454-327563190cb1",
      "migrations_dir": "migrations"
    }
  ],

  // Files. Create with `npx wrangler r2 bucket create project-memory-files`.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "project-memory-files" }],

  // OAuth tokens and sign-in state. Replace id after `npx wrangler kv namespace create OAUTH_KV`.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "c7c53d37107d4a84a1121adf023126ed" }],

  "observability": { "enabled": true }
}
